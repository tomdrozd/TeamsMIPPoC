{
  "Authentication": {
    "Enabled": true,
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "Audience": "api://<api-app-client-id>"
  },
  "MipIntegration": {
    "ServiceBaseUrl": "https://<mip-sdk-service-host>",
    "LabelLookupPath": "/labels/lookup",
    "Scope": "api://<mip-sdk-service-app-client-id>/.default",
    "TenantId": "<tenant-id>",
    "ClientId": "<api-client-id>",
    "ClientSecret": "<set-via-key-vault-or-env>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
